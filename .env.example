# Copy to .env and fill in your key. Every value has a default in src/router/config.py.

# Free key: https://aistudio.google.com -> Get API key
ROUTER_GEMINI_API_KEY=

# Models (provider: gemini | groq | ollama | openai_compat)
ROUTER_CHEAP_PROVIDER=gemini
ROUTER_CHEAP_MODEL=gemini-3.5-flash-lite
ROUTER_EXPENSIVE_PROVIDER=gemini
ROUTER_EXPENSIVE_MODEL=gemini-3.5-flash

# Requests per minute allowed by your plan (0 = unlimited) and documents per request
ROUTER_CHEAP_RPM=15
ROUTER_EXPENSIVE_RPM=10
ROUTER_CHEAP_BATCH_SIZE=10
ROUTER_EXPENSIVE_BATCH_SIZE=5

# Other providers
ROUTER_GROQ_API_KEY=
ROUTER_OPENAI_BASE_URL=
ROUTER_OPENAI_API_KEY=
ROUTER_OLLAMA_URL=http://localhost:11434

# Task rules
ROUTER_BUDGET=2100
ROUTER_COST_CHEAP=1
ROUTER_COST_EXPENSIVE=20
ROUTER_TARGET_ACCURACY=0.92
# max_accuracy = spend the budget on the riskiest documents
# target = stop once expected accuracy clears target + margin
ROUTER_POLICY=max_accuracy
ROUTER_CALIBRATION_SIZE=20
